# Office Closet — example environment configuration.
#
# Copy this file to `.env` (or export these variables in your shell) before
# starting the backend. The backend reads every variable here at startup; see
# backend/app/config.py and RUN.json for the authoritative list.
#
# `.env` is gitignored — never commit a real secret.

# SECRET_KEY signs the JWT auth tokens. The CI runner generates a fresh random
# value on every start, but a human starting the product must supply one.
# Generate a value with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# SQLite database file, relative to the backend/ directory.
DATABASE_URL=sqlite:///./wardrobe.db

# Directory where uploaded clothing images are stored.
UPLOAD_DIR=./uploads

# Origin of the frontend dev server (used for CORS).
FRONTEND_ORIGIN=http://localhost:5173

# Maximum upload size in megabytes.
MAX_UPLOAD_MB=5
