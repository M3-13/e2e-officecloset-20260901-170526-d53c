# Vorlage für lokale Umgebungsvariablen: kopiere diese Datei nach `.env`
# (oder exportiere die Werte manuell), passe sie an und starte den Server.

# JWT-Signierschlüssel. Wird nicht im Repo abgelegt — lokal erzeugen mit:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# SQLAlchemy-Datenbank-URL (SQLite-Default)
DATABASE_URL=sqlite:///./wardrobe.db

# Verzeichnis für hochgeladene Bilder
UPLOAD_DIR=./uploads

# Erlaubte CORS-Origin des Frontends
FRONTEND_ORIGIN=http://localhost:5173

# Maximale Bild-Upload-Größe in MB
MAX_UPLOAD_MB=5
